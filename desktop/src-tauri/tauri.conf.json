{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Rewards Desktop",
    "version": "../package.json",
    "identifier": "org.microsoftrewardsscript.desktop",
    "mainBinaryName": "Rewards Desktop",
    "build": {
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../out"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["../assets/icon.png", "icons/icon.ico"],
        "resources": {
            "../../LICENSE": "LICENSE"
        },
        "windows": {
            "webviewInstallMode": {
                "type": "downloadBootstrapper",
                "silent": true
            },
            "nsis": {
                "installMode": "currentUser",
                "displayLanguageSelector": false,
                "languages": ["SimpChinese", "English"]
            }
        }
    }
}
